## rm -rf $HOME/.config/kitty
## ln -s $DOTFILES/kitty $HOME/.config/kitty

# --- wezterm
## rm -rf $HOME/.wezterm.lua
## ln -s $DOTFILES/wezterm/wezterm.lua $HOME/.wezterm.lua

# --- zed
## rm -rf $HOME/.config/zed
## ln -s $DOTFILES/zed $HOME/.config/zed

# --- zellij
