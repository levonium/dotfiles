#!/usr/bin/env bash

DOTFILES=$(cd $(dirname "${BASH_SOURCE[0]}") && pwd)

# --- alacritty

rm -rf $HOME/.config/alacritty
ln -s $DOTFILES/alacritty $HOME/.config/alacritty

# --- neovim

rm -rf $HOME/.config/nvim
ln -s $DOTFILES/nvim $HOME/.config/nvim

# --- vscode

mkdir -p $HOME/.config/Code/User
rm -f $HOME/.config/Code/User/settings.json
rm -f $HOME/.config/Code/User/keybindings.json
ln -s $DOTFILES/vscode/settings.json $HOME/.config/Code/User/settings.json
ln -s $DOTFILES/vscode/keybindings.json $HOME/.config/Code/User/keybindings.json

if command -v code >/dev/null; then
  xargs -L1 code --install-extension < $DOTFILES/vscode/extensions.txt
fi

# --- ./shell

rm -rf $HOME/.shell
mkdir $HOME/.shell

ln -s $DOTFILES/shell/aliases $HOME/.shell/aliases
ln -sf $HOME/.shell/aliases $HOME/.bash_aliases

ln -s $DOTFILES/shell/prompt.sh $HOME/.shell/prompt
PROMTLINE='[ -f "$HOME/.shell/prompt" ] && source "$HOME/.shell/prompt"'
grep -qxF "$PROMTLINE" "$HOME/.bashrc" || echo "$PROMTLINE" >> "$HOME/.bashrc"

cp $DOTFILES/shell/workspace-indicators.css $HOME/workspace-indicators.css

source $DOTFILES/shell/keybindings
source $DOTFILES/shell/xkb-options

# --- ./scripts

mkdir -p $HOME/.local/bin
for script in "$DOTFILES"/scripts/*; do
  [ -x "$script" ] || continue   # skip if not executable
  rm -rf "$HOME/.local/bin/$(basename "$script")"
  ln -sf "$script" "$HOME/.local/bin/$(basename "$script")"
done

# --- $PATH

if ! echo "$PATH" | grep -q "$HOME/.local/bin"; then
  echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.bashrc"
fi

[ -f ~/.bashrc ] && source ~/.bashrc


# --- not used any longer, for now

# --- tmux
## source $DOTFILES/tmux/install

